# Dependencies (none currently, but keep safe)
node_modules/

# Test artifacts — regenerated by npm run smoke / qa
.smoke-profile/
.shots-profile/

# Generated screenshots — regenerated by npm run screenshots
screenshots/

# V1.6 push backend state (never commit — contains keys + device metadata)
.vapid-keys.json
.push-data.json
.push-data.json.tmp

# V1.6.4 Cloudflare Workers backend (secrets + local dev artifacts)
.wrangler/
.dev.vars
.wrangler-state/

# V2.0 native shell — www/ is generated by scripts/build-web.js
# (never hand-edit; the source of truth is the repo root web app)
/www/

# Apple credentials + Xcode noise (the ios/ project itself IS versioned)
*.p8
*.pem
*.mobileprovision
ios/App/Pods/
ios/App/App/public/
ios/App/DerivedData/
ios/App/output/
ios/App/App/capacitor.config.json

# Android build output + local SDK paths (the android/ project IS versioned)
android/app/src/main/assets/capacitor.config.json
android/.gradle/
android/app/build/
android/build/
android/local.properties
android/app/src/main/assets/public/

# Firebase / FCM credentials (never commit — later-phase files, ignored early)
google-services.json
GoogleService-Info.plist
firebase-service-account*.json

# Environment / secret files (never commit)
.env
.env.*


# OS junk
.DS_Store
Thumbs.db
