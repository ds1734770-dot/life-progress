// Cloudflare Workers configuration — Life Progress push backend (V1.6.4).
//
// Deployed separately from the GitHub Pages frontend (which stays untouched,
// §32). VAPID secrets are NEVER written here: set them with
//   npx wrangler secret put VAPID_PUBLIC_KEY   (and VAPID_PRIVATE_KEY / VAPID_SUBJECT)
// Secrets are injected as runtime env vars under the same names the Node
// backend uses (§6), so no code changes are needed between backends.
//
// FREE TIER SHAPE (§2/§25): one Worker, one SQLite Durable Object class.
// No KV, no R2, no Queues, no paid services.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "life-progress",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-08-01",

  // Deployment surface (explicit): workers.dev subdomain enabled, preview
  // URLs off. Workers Builds matches this name in CI.
  "workers_dev": true,
  "preview_urls": false,

  // Non-secret configuration (override at deploy time if needed).
  // Secrets (VAPID_*) are set via `wrangler secret put` — never here.
  "vars": {
    "PUSH_ALLOWED_ORIGINS": "https://ds1734770-dot.github.io"
  },

  // The authoritative notification store: SQLite-backed Durable Object (§4).
  "durable_objects": {
    "bindings": [
      { "name": "LP_PUSH", "class_name": "LPPushDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LPPushDO"] }
  ],

  // Scheduler trigger (V1.6.4): the Durable Object alarm drives production
  // scheduling (~1 tick/minute, self-rescheduling inside LPPushDO).
  // REASON the Cron Trigger is removed: Cloudflare Cron dispatch was
  // empirically non-functional in this deployment — the schedule was
  // registered (`* * * * *` since 2026-09-16T13:02Z), the `scheduled()`
  // handler existed, and redeploys/re-registrations were applied, yet
  // Cloudflare's own scheduled-invocation analytics recorded ZERO cron
  // invocations (2026-09-16 investigation). Keeping both triggers would
  // eventually double-run the tick once/if Cron dispatch recovers. The DO
  // alarm is the single authoritative production trigger; the `scheduled()`
  // handler in worker.js is retained only for local dev/testing.

  // Explicit empty array (per Cloudflare docs) so deploys REMOVE any
  // previously registered Cron Trigger instead of leaving it in place.
  "triggers": {
    "crons": []
  },

  "observability": {
    "enabled": false
  }
}
